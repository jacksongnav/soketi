{
	"name": "@soketi/soketi",
	"version": "0.0.0-dev",
	"description": "Just another simple, fast, and resilient open-source WebSockets server.",
	"repository": {
		"type": "git",
		"url": "https://github.com/soketi/soketi.git"
	},
	"main": "dist/index.js",
	"keywords": [
		"laravel",
		"socket.io",
		"broadcasting",
		"events",
		"redis",
		"socket",
		"pusher"
	],
	"author": "Alex Renoki",
	"license": "AGPL-3.0",
	"jshintConfig": {
		"esversion": 9
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.777.0",
		"@aws-sdk/client-lambda": "^3.777.0",
		"@aws-sdk/client-sqs": "^3.777.0",
		"@aws-sdk/util-dynamodb": "^3.777.0",
		"async": "^3.2.6",
		"axios": "^1.8.4",
		"bullmq": "^5.45.2",
		"dotenv": "^16.4.7",
		"ioredis": "^5.6.0",
		"knex": "^3.1.0",
		"mysql": "^2.18.1",
		"mysql2": "^3.14.0",
		"nats": "^2.29.3",
		"pg": "^8.14.1",
		"pm2": "^6.0.5",
		"prom-client": "^15.1.3",
		"pusher": "^5.2.0",
		"rate-limiter-flexible": "^6.2.1",
		"sqs-consumer": "^11.6.0",
		"uuid": "^11.1.0",
		"uWebSockets.js": "https://github.com/uNetworking/uWebSockets.js.git#v20.10.0",
		"yargs": "^17.7.2"
	},
	"devDependencies": {
		"@types/express": "^4.17.13",
		"@types/jest": "^28.1.6",
		"@types/node": "^18.7.6",
		"@typescript-eslint/eslint-plugin": "^8.29.0",
		"@typescript-eslint/parser": "^8.29.0",
		"body-parser": "^1.20.0",
		"eslint": "^9.23.0",
		"express": "^5.1.0",
		"jest": "^29.7.0",
		"jest-circus": "^29.7.0",
		"jest-cli": "^29.7.0",
		"pusher-js": "^8.4.0",
		"ts-jest": "^29.3.1",
		"tslib": "^2.3.1",
		"typescript": "^5.8.2"
	},
	"scripts": {
		"build": "node node_modules/typescript/bin/tsc",
		"build:watch": "npm run build -- -W",
		"lint": "eslint --ext .js,.ts ./src",
		"prepublish": "npm run build",
		"test": "jest --detectOpenHandles --forceExit --silent",
		"test:local": "jest --detectOpenHandles --forceExit --verbose",
		"test:watch": "npm test -- --watch"
	},
	"bin": {
		"soketi": "bin/server.js",
		"soketi-pm2": "bin/pm2.js"
	},
	"peerDependencies": {
		"@pm2/agent": "^2.0.3"
	},
	"type": "module"
}
