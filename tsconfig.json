{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "./dist",
		"sourceMap": false,
		"target": "ES2020",
		"noImplicitAny": false,
		"preserveConstEnums": true,
		"removeComments": true,
		"typeRoots": ["node_modules/@types"],
		"lib": ["ES2020", "dom"],
		"types": ["jest", "node"]
	},
	"include": ["./typings/**/*.ts", "./src/**/*.ts"],
	"exclude": ["node_modules"]
}